rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'thanhluan.soft@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProjectId(id) {
      return id is string && id.size() >= 3 && id.size() <= 10 && id.matches('^[A-F][0-9]{2}$');
    }

    function isValidStatus(status) {
      return status in [
        'Chưa cập nhật',
        'Chưa bắt đầu',
        'Đang thực hiện',
        'Hoàn thành',
        'Tạm dừng'
      ];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackerProject(data, userId, projectId) {
      return data.keys().hasAll(['projectId', 'ownerId', 'status', 'owner', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['projectId', 'ownerId', 'status', 'owner', 'note', 'createdAt', 'updatedAt'])
        && isValidProjectId(data.projectId)
        && data.projectId == projectId
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStatus(data.status)
        && data.owner is string && data.owner.size() <= 120
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackerPreferences(data, userId) {
      return data.keys().hasAll(['ownerId', 'budget', 'weights', 'completedTasks', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'budget', 'weights', 'completedTasks', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (data.budget is int || data.budget is float)
        && data.budget >= 0 && data.budget <= 1000000
        && data.weights is list && data.weights.size() == 8
        && data.weights[0] is int && data.weights[0] >= 0 && data.weights[0] <= 60
        && data.completedTasks is list && data.completedTasks.size() <= 20
        && (data.completedTasks.size() == 0 || (data.completedTasks[0] is int && data.completedTasks[0] >= 0 && data.completedTasks[0] < 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);

      allow delete: if false;

      match /trackerProjects/{projectId} {
        allow get: if isValidId(userId)
          && isValidProjectId(projectId)
          && (isOwner(userId) || isAdmin());

        allow list: if isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidProjectId(projectId)
          && isOwner(userId)
          && isValidTrackerProject(incoming(), userId, projectId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidProjectId(projectId)
          && isOwner(userId)
          && isValidTrackerProject(incoming(), userId, projectId)
          && incoming().ownerId == existing().ownerId
          && incoming().projectId == existing().projectId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['owner', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['note', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'owner', 'note', 'updatedAt'])
          );

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidProjectId(projectId)
          && isOwner(userId);
      }

      match /trackerMeta/{metaId} {
        allow get: if isValidId(userId)
          && metaId == 'preferences'
          && (isOwner(userId) || isAdmin());

        allow list: if isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && metaId == 'preferences'
          && isOwner(userId)
          && isValidTrackerPreferences(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && metaId == 'preferences'
          && isOwner(userId)
          && isValidTrackerPreferences(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completedTasks', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['budget', 'weights', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['budget', 'weights', 'completedTasks', 'updatedAt'])
          );

        allow delete: if false;
      }
    }
  }
}
