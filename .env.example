OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=1500
AI_RETRIEVAL_CHUNKS=6
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_QUESTION_CHARS=2000
AI_REQUESTS_PER_MINUTE=12
AI_MAX_CONCURRENT=3
AI_MAX_DAILY_REQUESTS=500
AI_DAILY_TOKEN_BUDGET=1000000
AI_TIMEOUT_MS=90000
AI_SESSION_TTL_MS=1800000
AI_HISTORY_TURNS=4
AI_MAX_SESSIONS=500
AI_ALLOWED_EMAIL_DOMAINS=
# Firebase Admin uses public project ID to verify existing Firebase ID tokens.
FIREBASE_PROJECT_ID=fleet-gravity-c5fd2
